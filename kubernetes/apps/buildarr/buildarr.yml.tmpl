---
# Rendered to /config/buildarr.yml at container start. ${VAR} placeholders are
# substituted from the buildarr-secrets env (buildarr has no native env interpolation).
buildarr:
  watch_config: false
  update_days:
    - "monday"
    - "tuesday"
    - "wednesday"
    - "thursday"
    - "friday"
    - "saturday"
    - "sunday"
  update_times:
    - "04:30"

# Sonarr scope is deliberately limited to quality definition sizes. Quality
# profiles and custom formats stay with recyclarr. Buildarr leaves any
# attribute it is not given alone (check_unmanaged defaults to false), and
# it PUTs each definition merged over the current remote object, so
# preferredSize is preserved.
#
# Sizes are megabytes per minute of runtime; Sonarr's UI shows GiB/hour
# (x60/1024). Without a max, Sonarr accepts whatever an indexer offers.
sonarr:
  hostname: "sonarr.sonarr.svc.cluster.local"
  port: 8989
  protocol: "http"
  api_key: "${SONARR_API_KEY}"
  settings:
    media_management:
      minimum_free_space: 20000
      use_hardlinks: true
      root_folders:
        - "/data/library/tv"
    quality:
      definitions:
        "Raw-HD": { min: 4, max: 150 }
        "HDTV-720p": { min: 10, max: 35 }
        "WEBRip-720p": { min: 10, max: 35 }
        "WEBDL-720p": { min: 10, max: 35 }
        "Bluray-720p": { min: 17.1, max: 50 }
        "HDTV-1080p": { min: 15, max: 55 }
        "WEBRip-1080p": { min: 15, max: 55 }
        "WEBDL-1080p": { min: 15, max: 55 }
        "Bluray-1080p": { min: 50.4, max: 80 }
        "Bluray-1080p Remux": { min: 69.1, max: 130 }
        "HDTV-2160p": { min: 25, max: 150 }
        "WEBRip-2160p": { min: 25, max: 150 }
        "WEBDL-2160p": { min: 25, max: 150 }
        "Bluray-2160p": { min: 94.6, max: 250 }
        "Bluray-2160p Remux": { min: 187.4, max: 400 }

radarr:
  hostname: "radarr.radarr.svc.cluster.local"
  port: 7878
  protocol: "http"
  api_key: "${RADARR_API_KEY}"
  settings:
    media_management:
      minimum_free_space: 20000
      use_hardlinks: true
      delete_empty_folders: true
      root_folders:
        delete_unmanaged: false
        definitions:
          - "/data/library/movies"
    quality:
      definitions:
        "HDTV-720p": { min: 17.1, preferred: 25, max: 35 }
        "WEBRip-720p": { min: 12.5, preferred: 25, max: 35 }
        "WEBDL-720p": { min: 12.5, preferred: 25, max: 35 }
        "Bluray-720p": { min: 25.7, preferred: 35, max: 50 }
        "HDTV-1080p": { min: 33.8, preferred: 35, max: 55 }
        "WEBRip-1080p": { min: 12.5, preferred: 35, max: 55 }
        "WEBDL-1080p": { min: 12.5, preferred: 35, max: 55 }
        "Bluray-1080p": { min: 50.8, preferred: 55, max: 80 }
        "Remux-1080p": { min: 102, preferred: 110, max: 130 }
        "Raw-HD": { min: 0, preferred: 100, max: 150 }
        "HDTV-2160p": { min: 85, preferred: 100, max: 150 }
        "WEBRip-2160p": { min: 34.5, preferred: 100, max: 150 }
        "WEBDL-2160p": { min: 34.5, preferred: 100, max: 150 }
        "Bluray-2160p": { min: 102, preferred: 175, max: 250 }
        "Remux-2160p": { min: 187.4, preferred: 300, max: 400 }

prowlarr:
  hostname: "prowlarr.prowlarr.svc.cluster.local"
  port: 9696
  protocol: "http"
  api_key: "${PROWLARR_API_KEY}"
  settings:
    tags:
      definitions:
        - "flaresolverr"
    apps:
      sync_profiles:
        delete_unmanaged: false
        definitions:
          "Standard":
            enable_automatic_search: true
            enable_interactive_search: true
            enable_rss: true
            minimum_seeders: 1
      applications:
        # false: never delete app links Buildarr does not manage (e.g. UI-created).
        delete_unmanaged: false
        definitions:
          "Sonarr":
            type: "sonarr"
            api_key: "${SONARR_API_KEY}"
            prowlarr_url: "http://prowlarr.prowlarr.svc.cluster.local:9696"
            base_url: "http://sonarr.sonarr.svc.cluster.local:8989"
            sync_level: "full-sync"
            sync_categories:
              - "TV"
              - "TV/Foreign"
              - "TV/SD"
              - "TV/HD"
              - "TV/UHD"
              - "TV/Other"
              - "TV/Anime"
          "Radarr":
            type: "radarr"
            api_key: "${RADARR_API_KEY}"
            prowlarr_url: "http://prowlarr.prowlarr.svc.cluster.local:9696"
            base_url: "http://radarr.radarr.svc.cluster.local:7878"
            sync_level: "full-sync"
            sync_categories:
              - "Movies"
              - "Movies/Foreign"
              - "Movies/Other"
              - "Movies/SD"
              - "Movies/HD"
              - "Movies/UHD"
              - "Movies/BluRay"
              - "Movies/3D"
              - "Movies/DVD"
              - "Movies/WEB-DL"
    indexers:
      proxies:
        delete_unmanaged: false
        definitions:
          "FlareSolverr":
            type: "flaresolverr"
            host_url: "http://flaresolverr.prowlarr.svc.cluster.local:8191/"
            request_timeout: 60
            tags:
              - "flaresolverr"
      indexers:
        # delete_unmanaged false keeps hand-added indexers; set true to make
        # this file the sole source of truth for Prowlarr indexers.
        #
        # Buildarr aborts the whole apply on the first indexer Prowlarr rejects
        # (it connectivity-tests each on create). Only manage indexers that pass
        # that test. Cloudflare/DDoS-Guard sites (1337x, TorrentGalaxy, YTS) fail
        # it even with FlareSolverr, so add those by hand in the Prowlarr UI.
        delete_unmanaged: false
        definitions:
          "The Pirate Bay":
            type: "thepiratebay"
            enable: true
            sync_profile: "Standard"
            priority: 25
          "LimeTorrents":
            type: "limetorrents"
            enable: true
            sync_profile: "Standard"
            priority: 25
          "Nyaa.si":
            type: "nyaasi"
            enable: true
            sync_profile: "Standard"
            priority: 25
